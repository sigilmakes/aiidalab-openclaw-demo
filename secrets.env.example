# Runtime secrets for services.aiidalab-openclaw-demo.
# Copy to /run/secrets/aiidalab-openclaw-demo.env (or point secretsFile at it)
# and fill in real values. Never commit a filled copy.
#
# Keys marked [base64] hold a base64-encoded file, not plain text.
# Generate a random value with: openssl rand -hex 32

# PostgreSQL password for the AiiDAlab database (aiidalab-db Secret).
AIIDA_DB_PASSWORD=

# Jupyter token that guards the AiiDAlab notebook service (aiidalab-jupyter Secret).
AIIDA_JUPYTER_TOKEN=

# Erlang cookie shared with AiiDA's RabbitMQ broker (RABBITMQ_ERLANG_COOKIE).
AIIDA_RABBIT_COOKIE=

# RabbitMQ password for AiiDA's broker user (aiidalab-rabbitmq Secret).
AIIDA_RABBIT_PASSWORD=

# OpenClaw gateway password (openclaw-gateway Secret).
CLAW_GATEWAY_TOKEN=

# Cloudflare tunnel credentials, copied from the tunnel's credentials JSON.
# Needed only when ingress.enable is true.
CLAW_TUNNEL_ACCOUNT_TAG=
CLAW_TUNNEL_ID=
CLAW_TUNNEL_SECRET=

# [base64] ed25519 private key AiiDAlab uses to reach the SLURM login node.
AIIDA_SLURM_KEY_B64=

# Matching public key, installed as the SLURM authorized_keys entry (plain text).
AIIDA_SLURM_PUB=

# [base64] MUNGE authentication key shared by the SLURM controller and compute nodes.
MUNGE_KEY_B64=

# [base64] Google Cloud application default credentials JSON for the Bifrost Vertex models.
VERTEX_ADC_B64=

# Bifrost setup token (bifrost-setup Secret).
BIFROST_SETUP_TOKEN=

# Bifrost virtual key OpenClaw presents when calling models. Empty keeps the live
# Secret; a fresh install needs the key minted in Bifrost first.
BIFROST_VK=

# Bearer token shared by the AiiDA MCP server and its OpenClaw client. Empty keeps
# the live value, or generates one when no aiida-mcp Secret exists yet.
AIIDA_MCP_TOKEN=
